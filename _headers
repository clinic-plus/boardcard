# Cloudflare Workers static assets: extra response headers for the site files.
# frame-ancestors stops other sites from embedding Boardcard or the admin panel inside their own page
# (clickjacking). It cannot be set from a <meta> tag, so it lives here.
/*
  Content-Security-Policy: frame-ancestors 'none'; form-action 'self'
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The service worker must always be re-checked so updates reach students quickly.
/sw.js
  Cache-Control: no-cache

# The admin panel is never stored by browsers or shown by search engines.
# Cloudflare serves admin.html at /admin (it drops the .html), so both paths are listed.
/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/admin.js
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow
