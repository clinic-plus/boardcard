{
  "name": "boardcard",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "boardcard-images" },
    { "binding": "USERDATA", "bucket_name": "boardcard-userdata" }
  ]
}
